# Copy to .env and adjust. Paths are relative to the project root.
DATA_DIR=data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/autograder
SANDBOX=auto
SANDBOX_IMAGE=autograder-sandbox:1
MAX_SANDBOXES=3
WORKER_JOBS=2
WSL_DISTRO=Ubuntu

OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=4096
LLM_PROFILE=laptop
MODEL_REVIEW=qwen2.5-coder:7b
MODEL_PRE=qwen2.5-coder:7b
MODEL_EXPLAIN=qwen2.5-coder:7b
LLM_CACHE_DIR=data/cache/llm
LLM_DISABLED=false
# Optional remote model for rules with "provider": "groq". Never commit a real key.
GROQ_API_KEY=

# 32+ random characters (openssl rand -hex 32). Left empty or weak, the API
# generates one and keeps it in DATA_DIR/jwt_secret.
JWT_SECRET=
# set to true when the site is served over HTTPS
COOKIE_SECURE=false
# only for development machines without Docker or ag-run
ALLOW_WEAK_SANDBOX=false

# Codacy (codacy_review analyzer). Install the CLI with sandbox/codacy_setup.sh
# (inside WSL on Windows). CODACY_CLI is a path inside WSL / on the Linux host.
CODACY_CLI=~/.local/bin/codacy-cli
CODACY_TEMPLATE_DIR=sandbox/codacy
CODACY_TIMEOUT_S=60
# Optional cloud mode: reads issues Codacy already computed for a file in a
# repository connected to Codacy. Account API token, provider gh|gl|bb, org, repo.
CODACY_API_TOKEN=
CODACY_PROVIDER=
CODACY_ORG=
CODACY_REPO=

# Login throttling. Only FAILED logins count toward the per-IP limit, so a whole class
# behind one campus NAT can log in together. Behind nginx, list its address here so the
# real client IP is read from X-Forwarded-For.
LOGIN_FAILS_PER_IP=30
LOGIN_ATTEMPTS_PER_IP=1000
TRUSTED_PROXIES=
